# PaginiumCMS – lokálny vývoj
# Skopíruj ako .env do koreňa projektu.

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# LAN test (nginx SPA + PHP backend) — pridaj origin frontendu, inak login vráti 401 z CORS
# CORS_ALLOWED_ORIGINS=http://192.168.10.26:8081
# TRUSTED_PROXIES=127.0.0.1,::1,192.168.10.26

# Frontend (Vite) – prefix VITE_ je povinný
# Pre LAN/production nechaj prázdne → klient použije window.location.origin (same host).
# Lokálny dev s Vite proxy: nechaj prázdne alebo http://localhost:8080
VITE_DEBUG=true
VITE_API_URL=
VITE_PUBLIC_URL=http://localhost:5173

# Developer mode (voliteľné)
DEVELOPER_MODE=true
DEV_UNLOCK_SECRET=secret code

# Demo sandbox — IBA demo.paginiumcms.com (nie zákaznícky balík)
# Na zákazníckej produkcii nechaj false.
DEMO_MODE=false
# DEMO_PUBLIC_URL=https://demo.paginiumcms.com
# DEMO_AUTO_RESET_MINUTES=60
# SESSION_LIFETIME=14400

# GitHub sync (voliteľné – admin /api/admin/github/*)
GITHUB_ENABLED=false
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
GITHUB_AUTO_SYNC=false
GITHUB_CONTENT_PATH=content
