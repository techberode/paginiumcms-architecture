# PaginiumCMS – lokálny vývoj
# Skopíruj ako .env do koreňa projektu.

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# ─── Secrets (REQUIRED in production, unique per environment, never commit) ───
# APP_KEY enables at-rest encryption of settings/user secrets (enc: prefix, ISS-170)
# and signs newsletter unsubscribe tokens. Empty = secrets stored without encryption.
# Generate: echo "base64:$(openssl rand -base64 32)"
# Rotating APP_KEY makes existing enc: values unreadable — re-enter secrets after rotation.
APP_KEY=
# Browser setup token — required for /api/setup/* outside development/local/testing.
# Generate: openssl rand -hex 24
SETUP_TOKEN=
# Headless API key pepper + short-lived JWT signing key (It.74) — separate values.
# Generate each: openssl rand -base64 48
API_KEY_PEPPER=
API_JWT_KEY=
# Redis requirepass (docker compose passes it to redis + php). Empty = no auth (loopback only).
REDIS_PASSWORD=
# Bind address for published dev ports (nginx :8080, Vite :3025). 0.0.0.0 = LAN only, never internet.
# PAGINIUM_BIND=127.0.0.1

# LAN test (nginx SPA + PHP backend) — pridaj origin frontendu, inak login vráti 401 z CORS
# Demo subdoména: APP_URL=https://demo.paginiumcms.com (musí sedieť s URL v prehliadači)
# CORS_ALLOWED_ORIGINS=http://192.168.10.26:8081
# Reverse proxy (host nginx → Docker PHP): nastav IP proxy explicitne, default je len loopback
# TRUSTED_PROXIES=127.0.0.1,::1,192.168.10.26

# Frontend (Vite) – prefix VITE_ je povinný
# Pre LAN/production nechaj prázdne → klient použije window.location.origin (same host).
# Lokálny dev s Vite proxy (:3025): nechaj PRÁZDNE → same-origin /api (cookies OK).
# NIKDY http://localhost:8080 pri FE na :3025 — cross-origin rozbije session (ISS-025).
VITE_DEBUG=true
VITE_API_URL=
VITE_PUBLIC_URL=http://localhost:5173

# Developer mode (voliteľné)
DEVELOPER_MODE=true
# Change this — ignored outside development/testing.
DEV_UNLOCK_SECRET="secret code"

# Demo sandbox — IBA demo.paginiumcms.com (nie zákaznícky balík)
# Na zákazníckej produkcii nechaj false.
DEMO_MODE=false
# DEMO_PUBLIC_URL=https://demo.paginiumcms.com
# DEMO_AUTO_RESET_MINUTES=60
# DEMO_STORAGE_QUOTA_BYTES=2147483648

# Maintainer-only Origin Panel (It.82). Never enable on customer installs.
ORIGIN_PANEL=false
# Host allow-list for the Origin Panel (comma separated). Required when ORIGIN_PANEL=true outside development.
ORIGIN_PANEL_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# V APP_ENV=development stačí ORIGIN_PANEL=true aj pre LAN IP (192.168.x.x).

# Prvý admin (scripts/first-run.sh → bootstrap-admin.php) — len ak ešte neexistuje žiadny user
# FIRST_ADMIN_EMAIL=admin@paginium.local
# FIRST_ADMIN_PASSWORD=Admin123!ChangeMe
# FIRST_ADMIN_NAME=Administrator
# Session (backend – .env v koreni projektu alebo backend/)
# SESSION_LIFETIME=28800          # sekundy; 120 je príliš málo — pri editácii min. 7200–28800
# SESSION_STRICT=false            # IP/UA binding za nginx – na LAN nechaj false
# SESSION_USE_STRICT_MODE=true    # PHP session.use_strict_mode (NIE to isté ako SESSION_STRICT!)
# SESSION_ABSOLUTE_MAX=86400      # max. vek session bez ohľadu na aktivitu (24 h)

# 2FA / TOTP — len vývoj (APP_ENV=development|local|testing)
# TWO_FACTOR_REQUIRED=false       # vypne TOTP middleware + login krok + vynútenie 2FA pri staff účtoch
# Na produkcii (APP_ENV=production) sa 2FA vždy vyžaduje bez ohľadu na túto premennú.

# Admin UI system deploy (production Docker — optional; prefer deploy key, see scripts/bootstrap-github-deploy-key.sh)
# GITHUB_DEPLOY_SSH_KEY_PATH=/run/secrets/github_deploy_key
# GITHUB_DEPLOY_TOKEN=ghp_…

# GitHub sync (voliteľné – admin /api/admin/github/*)
GITHUB_ENABLED=false
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
GITHUB_AUTO_SYNC=false
GITHUB_CONTENT_PATH=content

# API_KEY_PEPPER / API_JWT_KEY: see "Secrets" at the top. Loaded from project root .env
# or backend/.env (bootstrap prefers the root).
