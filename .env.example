# PaginiumCMS – lokálny vývoj
# Skopíruj ako .env do koreňa projektu.

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# Frontend (Vite) – prefix VITE_ je povinný
# Pre LAN/production nechaj prázdne → klient použije window.location.origin (same host).
# Lokálny dev s Vite proxy: nechaj prázdne alebo http://localhost:8080
VITE_DEBUG=true
VITE_API_URL=
VITE_PUBLIC_URL=http://localhost:5173

# Developer mode (voliteľné)
DEVELOPER_MODE=true
DEV_UNLOCK_SECRET=change-me-local-dev-secret

# Demo modul (voliteľné)
DEMO_MODE=false

# GitHub sync (voliteľné – admin /api/admin/github/*)
GITHUB_ENABLED=false
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
GITHUB_AUTO_SYNC=false
GITHUB_CONTENT_PATH=content
