{
    "name": "paginiumcms/core",
    "description": "PaginiumCMS Core - FlatFile Engine",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "symfony/console": "^7.0",
        "symfony/yaml": "^8.1",
        "league/commonmark": "^2.10",
        "spomky-labs/otphp": "^11.0",
        "bacon/bacon-qr-code": "^3.1",
        "php-di/php-di": "^7.1",
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8",
        "php-di/slim-bridge": "^3.4",
        "tuupola/cors-middleware": "^1.5",
        "sebastian/diff": "^5.0",
        "latte/latte": "^3.1",
        "respect/validation": "^3.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "mikey179/vfsstream": "^1.6",
        "vimeo/psalm": "dev-master",
        "squizlabs/php_codesniffer": "^4.0.2",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PaginiumCMS\\": "backend/app/"
        },
        "classmap": [
            "backend/app/Support/FileHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PaginiumCMS\\Tests\\": "backend/tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/phpunit --colors=never",
        "stan": "@php vendor/bin/phpstan analyse --memory-limit=512M --no-progress",
        "cs": "bash -c 'set -e; find backend/app backend/bootstrap -name \"*.php\" -type f -print0 | xargs -0 -n1 php -l >/dev/null'",
        "gate": "bash scripts/iteration-gate.sh"
    }
}
