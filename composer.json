{
    "name": "paginiumcms/core",
    "description": "PaginiumCMS Core - FlatFile Engine",
    "type": "project",
    "require": {
        "php": "^8.4",
        "symfony/yaml": "^7.0",
        "league/commonmark": "^2.0",
        "spomky-labs/otphp": "^11.0",
        "bacon/bacon-qr-code": "^2.0",
        "php-di/php-di": "^7.0",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.0",
        "php-di/slim-bridge": "^3.0",
        "tuupola/cors-middleware": "^1.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mikey179/vfsstream": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "PaginiumCMS\\": "backend/app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PaginiumCMS\\Tests\\": "backend/tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
