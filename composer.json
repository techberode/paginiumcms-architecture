{
    "name": "paginiumcms/core",
    "description": "PaginiumCMS Core - FlatFile Engine",
    "type": "project",
    "require": {
        "php": "^8.5",
        "symfony/yaml": "^7.0",
        "league/commonmark": "^2.0",
        "spomky-labs/otphp": "^11.0",
        "bacon/bacon-qr-code": "^2.0",
        "php-di/php-di": "^7.1",
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8",
        "php-di/slim-bridge": "^3.4",
        "tuupola/cors-middleware": "^1.5",
        "sebastian/diff": "^5.0",
        "latte/latte": "^3.1",
        "respect/validation": "^3.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "mikey179/vfsstream": "^1.6",
        "vimeo/psalm": "dev-master",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "PaginiumCMS\\": "backend/app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PaginiumCMS\\Tests\\": "backend/tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "check": [
            "@stan",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
