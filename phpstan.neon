includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 8

    paths:
        - backend/app
        - backend/bootstrap
        - backend/tests
        - backend/bin

    scanDirectories:
        - backend/app/Support
        - backend/app/Modules

    excludePaths:
        - backend/vendor/*
        - backend/storage/*
        - backend/public/*

    phpVersion: 80500

    ignoreErrors:
        # Legacy routes folder removed; public debug scripts excluded above.
