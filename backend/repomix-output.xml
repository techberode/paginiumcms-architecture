    {
        return $this->altText;
    }

    public function setAltText(string $altText): self
    {
        $this->altText = $altText;
        return $this;
    }

    public function getUploadedAtDateTime(): DateTimeImmutable
    {
        return new DateTimeImmutable('@' . $this->uploadedAt);
    }

