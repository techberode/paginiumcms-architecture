<?php
// backend/public/index.php

use Psr\Http\Message\ResponseInterface as Response;
use Psr\Http\Message\ServerRequestInterface as Request;
use Slim\Factory\AppFactory;
use Slim\Middleware\MethodOverrideMiddleware;
use Slim\Psr7\Stream;

require __DIR__ . '/../../vendor/autoload.php';

// ============================================================
# CORS HEADERS - NAJPRV
// ============================================================
header('Access-Control-Allow-Origin: http://localhost:3022');
header('Access-Control-Allow-Credentials: true');
header('Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS');
header('Access-Control-Allow-Headers: Content-Type, Authorization, X-CSRF-TOKEN, X-Requested-With');

if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(200);
    echo json_encode(['success' => true]);
    exit();
}

// ============================================================
# VYTVORENIE APP
// ============================================================
$app = AppFactory::create();

// ============================================================
# MIDDLEWARE - CORS
// ============================================================
$app->add(function ($request, $handler) {
    $response = $handler->handle($request);
    return $response
    ->withHeader('Access-Control-Allow-Origin', 'http://localhost:3022')
    ->withHeader('Access-Control-Allow-Credentials', 'true')
    ->withHeader('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS')
    ->withHeader('Access-Control-Allow-Headers', 'Content-Type, Authorization, X-CSRF-TOKEN, X-Requested-With');
});

// ============================================================
# POMOCNÉ FUNKCIE PRE JSON RESPONSE
// ============================================================
function jsonResponse($data, $status = 200): Response {
    $response = new \Slim\Psr7\Response();
    $response->getBody()->write(json_encode($data));
    return $response
    ->withHeader('Content-Type', 'application/json')
    ->withStatus($status);
}

function getInput(Request $request): array {
    return json_decode($request->getBody()->getContents(), true) ?? [];
}

// ============================================================
# DEFINÍCIA CIEST
// ============================================================

// ============================================================
# STATUS / HEALTH
// ============================================================
$app->get('/v1/status', function (Request $request, Response $response) {
    return jsonResponse([
        'success' => true,
        'status' => 'online',
        'version' => '1.0.0',
        'php_version' => phpversion(),
                        'time' => date('c')
    ]);
});

// ============================================================
# AUTH
// ============================================================
$app->post('/v1/auth', function (Request $request, Response $response) {
    $input = getInput($request);
    $action = $input['action'] ?? '';

    // Login
    if ($action === 'login') {
        $email = trim($input['email'] ?? '');
        $password = $input['password'] ?? '';

        if (empty($email) || empty($password)) {
            return jsonResponse(['success' => false, 'error' => 'Chýbajúce prihlasovacie údaje'], 400);
        }

        $usersFile = __DIR__ . '/../../storage/users.json';
        $users = file_exists($usersFile) ? json_decode(file_get_contents($usersFile), true) : [];
        $foundUser = null;

        foreach ($users as $user) {
            $userEmail = $user['email'] ?? '';
            $userUsername = $user['username'] ?? '';
            if ($userEmail === $email || $userUsername === $email) {
                if (password_verify($password, $user['password'] ?? '')) {
                    $foundUser = $user;
                    break;
                }
            }
        }

        if (!$foundUser) {
            return jsonResponse(['success' => false, 'error' => 'Nesprávne prihlasovacie údaje'], 401);
        }

        unset($foundUser['password']);
        unset($foundUser['verificationToken']);

        return jsonResponse([
            'success' => true,
            'message' => 'Prihlásenie úspešné',
            'user' => [
                'id' => $foundUser['id'],
                'name' => $foundUser['name'] ?? $foundUser['username'],
                'username' => $foundUser['username'],
                'email' => $foundUser['email'],
                'role' => $foundUser['role'] ?? 'user',
                'verified' => $foundUser['verified'] ?? true,
            ]
        ]);
    }

    // Register
    if ($action === 'register') {
        $name = trim($input['name'] ?? $input['displayName'] ?? '');
        $email = trim($input['email'] ?? '');
        $username = trim($input['username'] ?? '');
        $password = $input['password'] ?? '';
        $passwordConfirm = $input['passwordConfirm'] ?? $input['confirmPassword'] ?? '';

        $errors = [];
        if (empty($name) || strlen($name) < 2) $errors[] = 'Meno musí mať aspoň 2 znaky';
        if (empty($email) || !filter_var($email, FILTER_VALIDATE_EMAIL)) $errors[] = 'Zadajte platnú emailovú adresu';
        if (empty($username) || strlen($username) < 2) $errors[] = 'Používateľské meno musí mať aspoň 2 znaky';
        if (empty($password) || strlen($password) < 8) $errors[] = 'Heslo musí mať aspoň 8 znakov';
        if ($password !== $passwordConfirm) $errors[] = 'Heslá sa nezhodujú';

        if (!empty($errors)) {
            return jsonResponse(['success' => false, 'errors' => $errors], 400);
        }

        $usersFile = __DIR__ . '/../../storage/users.json';
        $users = file_exists($usersFile) ? json_decode(file_get_contents($usersFile), true) : [];

        foreach ($users as $user) {
            if (($user['email'] ?? '') === $email) {
                return jsonResponse(['success' => false, 'errors' => ['Používateľ s týmto emailom už existuje']], 409);
            }
            if (($user['username'] ?? '') === $username) {
                return jsonResponse(['success' => false, 'errors' => ['Používateľské meno je už obsadené']], 409);
            }
        }

        $hashedPassword = password_hash($password, PASSWORD_BCRYPT);
        $newUser = [
            'id' => uniqid('user_'),
           'name' => $name,
           'username' => $username,
           'email' => $email,
           'password' => $hashedPassword,
           'role' => 'user',
           'verified' => true,
           'createdAt' => date('c'),
           'updatedAt' => date('c')
        ];

        $users[] = $newUser;
        file_put_contents($usersFile, json_encode($users, JSON_PRETTY_PRINT));

        unset($newUser['password']);
        return jsonResponse([
            'success' => true,
            'message' => 'Registrácia úspešná!',
            'user' => $newUser
        ]);
    }

    return jsonResponse(['success' => false, 'error' => 'Neznáma akcia'], 400);
});

