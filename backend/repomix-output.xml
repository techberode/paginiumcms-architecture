$settingsFile = __DIR__ . '/../../storage/settings.json';

function getSettings() {
    global $settingsFile;
    if (!file_exists($settingsFile)) {
        // Vytvor predvolené nastavenia
        $default = [
            'siteName' => 'PaginiumCMS',
            'siteTagline' => 'Moderný FlatFile CMS',
