<?php
// ============================================================
// SYSTEM API - EXPORT/IMPORT ZÁLOHY
// ============================================================

header('Content-Type: application/json');
header('Access-Control-Allow-Origin: http://localhost:3022');
header('Access-Control-Allow-Credentials: true');
header('Access-Control-Allow-Methods: GET, POST, OPTIONS');
header('Access-Control-Allow-Headers: Content-Type, Authorization, X-CSRF-TOKEN');

// Spracovanie OPTIONS
if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(200);
    echo json_encode(['success' => true]);
    exit();
}

$method = $_SERVER['REQUEST_METHOD'];
$input = json_decode(file_get_contents('php://input'), true) ?? [];

// ============================================================
// KONFIGURÁCIA
// ============================================================
$contentDir = __DIR__ . '/../../content/';
$storageDir = __DIR__ . '/../../storage/backups/';

if (!is_dir($storageDir)) {
    mkdir($storageDir, 0755, true);
}

// ============================================================
// POMOCNÉ FUNKCIE
// ============================================================

/**
 * Načíta všetok obsah z adresára rekurzívne
 */
function readDirectory($dir, $baseDir = '') {
    $result = [];
    $files = scandir($dir);

    foreach ($files as $file) {
        if ($file === '.' || $file === '..') continue;

        $path = $dir . '/' . $file;
        $relativePath = $baseDir ? $baseDir . '/' . $file : $file;

        if (is_dir($path)) {
            $result[$relativePath] = readDirectory($path, $relativePath);
        } else {
            $result[$relativePath] = file_get_contents($path);
        }
    }

    return $result;
}

/**
 * Rekurzívne vymazanie adresára
 */
function deleteDirectory($dir) {
    if (!file_exists($dir)) return true;
    if (!is_dir($dir)) return unlink($dir);

    foreach (scandir($dir) as $item) {
        if ($item === '.' || $item === '..') continue;
        deleteDirectory($dir . '/' . $item);
    }

    return rmdir($dir);
}

/**
 * Rekurzívne uloženie dát do adresára
 */
function writeDirectory($dir, $data) {
    if (!is_dir($dir)) {
        mkdir($dir, 0755, true);
    }

    foreach ($data as $path => $content) {
        $fullPath = $dir . '/' . $path;
        $parentDir = dirname($fullPath);

        if (!is_dir($parentDir)) {
            mkdir($parentDir, 0755, true);
        }

        if (is_array($content)) {
            // Ak je to adresár, rekurzívne ho vytvoríme
            writeDirectory($fullPath, $content);
        } else {
            file_put_contents($fullPath, $content);
        }
    }
}

// ============================================================
// SPRACOVANIE REQUESTU
// ============================================================
try {
    switch ($method) {
        case 'GET':
            $action = $_GET['action'] ?? '';

            if ($action === 'export') {
                // ============================================================
                // EXPORT ZÁLOHY
                // ============================================================
                $data = [
                    'version' => '1.0.0',
                    'exportedAt' => date('c'),
                    'content' => readDirectory($contentDir)
                ];

                // Uloženie do súboru pre prípad potreby
                $backupFile = $storageDir . 'backup_' . date('Y-m-d_His') . '.json';
                file_put_contents($backupFile, json_encode($data, JSON_PRETTY_PRINT));

                echo json_encode([
                    'success' => true,
                    'data' => $data,
                    'message' => 'Záloha vygenerovaná'
                ]);
            } else {
                // Zoznam záloh
                $backups = glob($storageDir . '*.json');
                $backupList = [];
                foreach ($backups as $file) {
                    $backupList[] = [
                        'name' => basename($file),
                        'size' => filesize($file),
                        'created' => date('c', filectime($file))
                    ];
                }

                echo json_encode([
                    'success' => true,
                    'data' => $backupList
                ]);
            }
            break;

        case 'POST':
            $action = $_GET['action'] ?? $input['action'] ?? '';

            if ($action === 'import') {
                // ============================================================
                // IMPORT ZÁLOHY
                // ============================================================
                $data = $input['data'] ?? null;

                // Ak dáta neprišli v JSON, skús ich načítať z raw input
                if (!$data) {
                    $rawInput = file_get_contents('php://input');
                    $decoded = json_decode($rawInput, true);
                    if ($decoded && isset($decoded['data'])) {
                        $data = $decoded['data'];
                    }
                }

                // Kontrola či dáta existujú
                if (!$data) {
                    http_response_code(400);
                    echo json_encode([
                        'success' => false,
                        'error' => 'Chýbajúce dáta zálohy'
                    ]);
                    break;
                }

                // Kontrola či sú dáta v správnom formáte
                if (!isset($data['content']) || !isset($data['version'])) {
                    http_response_code(400);
                    echo json_encode([
                        'success' => false,
                        'error' => 'Neplatný formát zálohy - chýba "content" alebo "version"'
                    ]);
                    break;
