                'password' => '',
                'encryption' => 'tls',
                'from_email' => 'noreply@webland.fun',
                'from_name' => 'PaginiumCMS',
                'enabled' => false
            ],
            'comments' => [
                'enabled' => true,
                'requireApproval' => true,
                'minCommentLength' => 3,
                'maxCommentLength' => 1000,
                'spamKeywords' => ['viagra', 'casino', 'porn']
            ],
            'analytics' => [
                'enabled' => true,
                'geoip' => true
            ]
        ];
        file_put_contents($settingsFile, json_encode($default, JSON_PRETTY_PRINT));
        return $default;
    }
    $content = file_get_contents($settingsFile);
    return json_decode($content, true) ?? [];
}

function saveSettings($settings) {
    global $settingsFile;
    file_put_contents($settingsFile, json_encode($settings, JSON_PRETTY_PRINT));
}

try {
    switch ($method) {
        case 'GET':
            $settings = getSettings();
            echo json_encode([
                'success' => true,
                'data' => $settings
            ]);
            break;

            // ============================================================
            # 🔧 PUT - AKTUALIZÁCIA NASTAVENÍ
            // ============================================================
        case 'PUT':
            $newSettings = $input['settings'] ?? $input;

            if (empty($newSettings)) {
                http_response_code(400);
                echo json_encode([
                    'success' => false,
                    'error' => 'Chýbajúce nastavenia'
                ]);
                break;
            }

            // Načítaj existujúce nastavenia
            $currentSettings = getSettings();

            // Prejdi všetky polia a aktualizuj ich
            foreach ($newSettings as $key => $value) {
                if (is_array($value) && isset($currentSettings[$key]) && is_array($currentSettings[$key])) {
                    // Rekurzívne aktualizácia pre vnorené polia (smtp, comments, analytics)
                    $currentSettings[$key] = array_merge($currentSettings[$key], $value);
                } else {
                    $currentSettings[$key] = $value;
                }
            }

            saveSettings($currentSettings);

            echo json_encode([
                'success' => true,
                'message' => 'Nastavenia boli uložené',
                'data' => $currentSettings
            ]);
            break;

            // ============================================================
            # POST - Vytvorenie nových nastavení (ak neexistujú)
            // ============================================================
        case 'POST':
            $newSettings = $input['settings'] ?? $input;
            saveSettings($newSettings);
            echo json_encode([
                'success' => true,
                'message' => 'Nastavenia vytvorené',
                'data' => $newSettings
            ]);
            break;

        default:
            http_response_code(405);
            echo json_encode([
                'success' => false,
                'error' => 'Metóda nie je podporovaná'
            ]);
    }
} catch (Exception $e) {
    http_response_code(500);
    echo json_encode([
        'success' => false,
        'error' => $e->getMessage()
    ]);
}
