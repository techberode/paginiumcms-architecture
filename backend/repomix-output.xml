header('Access-Control-Allow-Credentials: true');
header('Access-Control-Allow-Methods: GET, POST, PUT, OPTIONS');
header('Access-Control-Allow-Headers: Content-Type, Authorization, X-CSRF-TOKEN');

if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(200);
    echo json_encode(['success' => true]);
    exit();
}

// ============================================================
# AUTENTIFIKÁCIA
// ============================================================
require_once __DIR__ . '/../../core/Auth.php';
$auth = new Auth();
$token = $_SERVER['HTTP_AUTHORIZATION'] ?? '';
$token = str_replace('Bearer ', '', $token);

$payload = $auth->verifyJWT($token);
if (!$payload || $payload['role'] !== 'admin') {
    http_response_code(401);
    echo json_encode(['success' => false, 'error' => 'Neoprávnený prístup']);
    exit();
}

// ============================================================
# SPRACOVANIE REQUESTU
// ============================================================
require_once __DIR__ . '/../../core/GitHubSync.php';

$method = $_SERVER['REQUEST_METHOD'];
$input = json_decode(file_get_contents('php://input'), true) ?? [];

try {
    $sync = GitHubSync::getInstance();
    
    switch ($method) {
        case 'GET':
            $action = $_GET['action'] ?? '';
            
            if ($action === 'status') {
                echo json_encode([
                    'success' => true,
                    'data' => $sync->getStatus(),
                    'config' => $sync->getConfig(),
                ]);
            } elseif ($action === 'history') {
                $limit = $_GET['limit'] ?? 10;
                echo json_encode([
                    'success' => true,
                    'data' => $sync->getHistory($limit),
                ]);
            } else {
                echo json_encode([
                    'success' => true,
                    'config' => $sync->getConfig(),
                    'git_available' => $sync->isGitAvailable(),
                ]);
            }
            break;
            
        case 'POST':
            $action = $input['action'] ?? '';
            
            if ($action === 'sync') {
                $message = $input['message'] ?? null;
                $files = $input['files'] ?? null;
                $result = $sync->sync($message, $files);
                
                echo json_encode([
                    'success' => $result['success'],
                    'data' => $result,
                ]);
            } elseif ($action === 'init') {
                $result = $sync->initRepo();
                echo json_encode($result);
            } else {
                http_response_code(400);
                echo json_encode([
                    'success' => false,
                    'error' => 'Neznáma akcia',
                ]);
            }
            break;
            
        case 'PUT':
            $config = $input['config'] ?? [];
            $result = $sync->setConfig($config);
            echo json_encode([
                'success' => true,
                'data' => $result,
                'message' => 'Konfigurácia uložená',
            ]);
            break;
            
        default:
            http_response_code(405);
            echo json_encode([
                'success' => false,
                'error' => 'Metóda nie je podporovaná',
            ]);
    }
    
} catch (Exception $e) {
    http_response_code(500);
    echo json_encode([
        'success' => false,
        'error' => $e->getMessage(),
    ]);
}
