        $job = new Job('test_job', function () use (&$executed) {
            $executed = true;
        }, '0 0 31 2 *'); // 31. február neexistuje

        $this->scheduler->addJob($job);
        $this->scheduler->run();

        $this->assertFalse($executed);
    }
