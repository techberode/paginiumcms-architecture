$settingsFile = __DIR__ . '/../../storage/settings.json';
$settings = [];
if (file_exists($settingsFile)) {
    $settings = json_decode(file_get_contents($settingsFile), true) ?? [];
}

$smtpConfig = $settings['smtp'] ?? [
    'host' => 'mail.webland.fun',
'port' => 587,
'username' => '',
'password' => '',
'encryption' => 'tls',
'from_email' => 'noreply@webland.fun',
'from_name' => 'PaginiumCMS',
'enabled' => false
];

// ============================================================
# TESTOVACIA FUNKCIA (BEZ MAILER)
// ============================================================
function testSmtpConnection($config) {
    $result = [
        'success' => false,
        'message' => '',
        'details' => []
    ];

    // 1. Kontrola hosta
    if (empty($config['host'])) {
        $result['message'] = 'Chýba SMTP server (host)';
        return $result;
    }

    // 2. Kontrola portu
    $port = (int)$config['port'];
    if ($port < 1 || $port > 65535) {
        $result['message'] = 'Neplatný port';
        return $result;
    }

    // 3. Test pripojenia cez socket
    $timeout = 5;
    $connection = @fsockopen($config['host'], $port, $errno, $errstr, $timeout);

    if (!$connection) {
        $result['message'] = "Nepodarilo sa pripojiť k serveru: $errstr ($errno)";
        return $result;
    }

    fclose($connection);
    $result['details']['connection'] = "✅ Pripojenie k serveru {$config['host']}:{$port} úspešné";

    // 4. Simulácia odoslania emailu
    $result['details']['email_test'] = '📧 Testovací email bol simulovaný (SMTP vypnuté)';
    $result['success'] = true;
    $result['message'] = 'Pripojenie k serveru úspešné! (Email je simulovaný)';

    return $result;
}

