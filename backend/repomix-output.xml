<?php
// ============================================================
// BLOG API - SPRÁVA ČLÁNKOV (S ÚLOŽISKOM V SÚBOROCH)
// ============================================================

header('Content-Type: application/json');
header('Access-Control-Allow-Origin: http://localhost:3022');
header('Access-Control-Allow-Credentials: true');
header('Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS');
header('Access-Control-Allow-Headers: Content-Type, Authorization, X-CSRF-TOKEN');

// Spracovanie OPTIONS
if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(200);
    echo json_encode(['success' => true]);
    exit();
}

$method = $_SERVER['REQUEST_METHOD'];
$input = json_decode(file_get_contents('php://input'), true) ?? [];

// ============================================================
// KONFIGURÁCIA
// ============================================================
$contentDir = __DIR__ . '/../../content/blog/';
if (!is_dir($contentDir)) {
    mkdir($contentDir, 0755, true);
}

// ============================================================
// POMOCNÉ FUNKCIE
// ============================================================

/**
 * Načíta všetky články z adresára
 */
function loadArticles($dir) {
    $articles = [];
    $files = glob($dir . '*.md');

    foreach ($files as $file) {
        $content = file_get_contents($file);
        $parsed = parseMarkdown($content);
        $filename = basename($file, '.md');

        // Extrahovanie dátumu z názvu súboru (YYYY-MM-DD-nazov)
        $date = '';
        $slug = $filename;
        if (preg_match('/^(\d{4}-\d{2}-\d{2})-(.+)$/', $filename, $matches)) {
            $date = $matches[1];
            $slug = $matches[2];
        }

        $articles[] = [
            'id' => 'article_' . $filename,
            'path' => 'blog/' . basename($file),
            'type' => 'article',
            'frontmatter' => array_merge([
                'title' => $slug,
                'slug' => $slug,
                'status' => 'published',
                'description' => '',
                'date' => $date ?: date('Y-m-d'),
                                         'author' => 'admin',
                                         'tags' => []
            ], $parsed['frontmatter']),
            'content' => $parsed['content'],
            'createdAt' => date('c', filectime($file)),
            'updatedAt' => date('c', filemtime($file)),
            'sizeBytes' => filesize($file)
        ];
    }

    // Zoradenie podľa dátumu (od najnovších)
    usort($articles, function($a, $b) {
        return strtotime($b['frontmatter']['date']) - strtotime($a['frontmatter']['date']);
    });

    return $articles;
}

/**
 * Parsuje Markdown s Frontmatter
 */
function parseMarkdown($content) {
    $frontmatter = [];
    $markdown = $content;

    if (preg_match('/^---\s*\n(.*?)\n---\s*\n(.*)/s', $content, $matches)) {
        $frontmatter = parseYaml($matches[1]);
        $markdown = $matches[2];
    }

    return ['frontmatter' => $frontmatter, 'content' => $markdown];
}

/**
 * Jednoduchý YAML parser pre Frontmatter
 */
function parseYaml($yaml) {
    $data = [];
    $lines = explode("\n", $yaml);
    foreach ($lines as $line) {
        if (trim($line) === '') continue;
        if (preg_match('/^([a-zA-Z0-9_]+):\s*(.*)$/', $line, $matches)) {
            $key = $matches[1];
            $value = trim($matches[2]);
            if (preg_match('/^\[(.*)\]$/', $value, $listMatch)) {
                $value = array_map('trim', explode(',', $listMatch[1]));
            }
            $data[$key] = $value;
        }
    }
    return $data;
}

/**
 * Vytvorí Markdown s Frontmatter
 */
function createMarkdown($frontmatter, $content) {
    $yaml = '';
    foreach ($frontmatter as $key => $value) {
        if (is_array($value)) {
            $value = '[' . implode(', ', $value) . ']';
        }
        $yaml .= $key . ': ' . $value . "\n";
    }
    return "---\n" . $yaml . "---\n\n" . $content;
}

// ============================================================
// SPRACOVANIE REQUESTU
// ============================================================
try {
    $slug = $_GET['slug'] ?? null;

    switch ($method) {
        case 'GET':
            $articles = loadArticles($contentDir);

            if ($slug) {
                $found = null;
                foreach ($articles as $article) {
                    if ($article['frontmatter']['slug'] === $slug) {
                        $found = $article;
                        break;
                    }
                }

                if ($found) {
                    echo json_encode([
                        'success' => true,
                        'data' => $found
                    ]);
                } else {
                    http_response_code(404);
                    echo json_encode([
                        'success' => false,
                        'error' => "Článok '$slug' nenájdený"
                    ]);
                }
            } else {
                echo json_encode([
                    'success' => true,
                    'data' => $articles,
                    'count' => count($articles)
                ]);
            }
            break;

        case 'POST':
            // Vytvorenie nového článku
            $slug = $input['slug'] ?? 'novy-clanok-' . uniqid();
            $date = date('Y-m-d');
            $filename = $contentDir . $date . '-' . $slug . '.md';

            $frontmatter = [
                'title' => $input['title'] ?? 'Nový článok',
                'slug' => $slug,
                'status' => $input['status'] ?? 'draft',
                'description' => $input['description'] ?? '',
                'date' => $date,
                'author' => $input['author'] ?? 'admin',
                'tags' => $input['tags'] ?? []
            ];

            $content = $input['content'] ?? '# Nový článok';
            $markdown = createMarkdown($frontmatter, $content);

            file_put_contents($filename, $markdown);

            echo json_encode([
                'success' => true,
                'message' => 'Článok vytvorený',
                'data' => [
                    'id' => 'article_' . $slug,
                    'path' => 'blog/' . basename($filename),
                             'type' => 'article',
                             'frontmatter' => $frontmatter,
                             'content' => $content,
                             'createdAt' => date('c'),
                             'updatedAt' => date('c'),
                             'sizeBytes' => strlen($markdown)
                ]
            ]);
            break;

        case 'PUT':
            // ============================================================
            // AKTUALIZÁCIA ČLÁNKU - ULOŽENIE DO SÚBORU
            // ============================================================
            $slug = $_GET['slug'] ?? $input['slug'] ?? '';

            if (empty($slug)) {
                http_response_code(400);
                echo json_encode([
                    'success' => false,
                    'error' => 'Chýbajúci slug'
                ]);
                break;
            }

            // Nájdi existujúci súbor
            $files = glob($contentDir . '*-' . $slug . '.md');
            $filename = null;

            if (!empty($files)) {
                $filename = $files[0];
            }

            // Ak článok neexistuje, vytvor nový
            if (!$filename) {
                $date = date('Y-m-d');
                $filename = $contentDir . $date . '-' . $slug . '.md';
                $isNew = true;
            } else {
                $isNew = false;
                // Načítaj existujúci frontmatter pre zachovanie dátumu
                $existing = file_get_contents($filename);
                $parsed = parseMarkdown($existing);
                $existingFrontmatter = $parsed['frontmatter'];
            }

            // Príprava frontmatter
            $frontmatter = [
                'title' => $input['title'] ?? ($existingFrontmatter['title'] ?? 'Článok'),
                'slug' => $slug,
                'status' => $input['status'] ?? ($existingFrontmatter['status'] ?? 'published'),
                'description' => $input['description'] ?? ($existingFrontmatter['description'] ?? ''),
                'date' => $existingFrontmatter['date'] ?? date('Y-m-d'),
                'author' => $input['author'] ?? ($existingFrontmatter['author'] ?? 'admin'),
                'tags' => $input['tags'] ?? ($existingFrontmatter['tags'] ?? [])
            ];

            $content = $input['content'] ?? ($parsed['content'] ?? '# Obsah článku');
            $markdown = createMarkdown($frontmatter, $content);

            // Uloženie do súboru
            file_put_contents($filename, $markdown);

            echo json_encode([
                'success' => true,
                'message' => $isNew ? 'Článok vytvorený' : "Článok '$slug' aktualizovaný",
                'data' => [
                    'id' => 'article_' . $slug,
                    'path' => 'blog/' . basename($filename),
                             'type' => 'article',
                             'frontmatter' => $frontmatter,
                             'content' => $content,
                             'createdAt' => date('c', filectime($filename)),
                             'updatedAt' => date('c', filemtime($filename)),
                             'sizeBytes' => filesize($filename)
                ]
            ]);
            break;

            case 'DELETE':
                $slug = $_GET['slug'] ?? $input['slug'] ?? '';

                if (empty($slug)) {
                    http_response_code(400);
                    echo json_encode([
                        'success' => false,
                        'error' => 'Chýbajúci slug'
                    ]);
                    break;
                }

                // Nájdi a zmaž súbor
                $files = glob($contentDir . '*-' . $slug . '.md');
                if (!empty($files)) {
                    unlink($files[0]);
                    echo json_encode([
                        'success' => true,
                        'message' => "Článok '$slug' vymazaný"
                    ]);
                } else {
                    http_response_code(404);
                    echo json_encode([
                        'success' => false,
                        'error' => "Článok '$slug' nenájdený"
                    ]);
                }
                break;

            default:
                http_response_code(405);
                echo json_encode([
                    'success' => false,
                    'error' => 'Metóda nie je podporovaná'
                ]);
    }
} catch (Exception $e) {
    http_response_code(500);
    echo json_encode([
        'success' => false,
        'error' => $e->getMessage()
    ]);
}
