// ============================================================
// MAIL TEST API - TESTOVANIE SMTP NASTAVENÍ (BEZ MAILER)
// ============================================================

header('Content-Type: application/json');
header('Access-Control-Allow-Origin: http://localhost:3022');
header('Access-Control-Allow-Credentials: true');
header('Access-Control-Allow-Methods: POST, OPTIONS');
header('Access-Control-Allow-Headers: Content-Type, Authorization, X-CSRF-TOKEN');

if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(200);
    echo json_encode(['success' => true]);
    exit();
}

$input = json_decode(file_get_contents('php://input'), true) ?? [];

// ============================================================
# NAČÍTANIE NASTAVENÍ
// ============================================================
$settingsFile = __DIR__ . '/../../storage/settings.json';
$settings = [];
if (file_exists($settingsFile)) {
    $settings = json_decode(file_get_contents($settingsFile), true) ?? [];
}

$smtpConfig = $settings['smtp'] ?? [
    'host' => 'mail.webland.fun',
'port' => 587,
'username' => '',
'password' => '',
'encryption' => 'tls',
'from_email' => 'noreply@webland.fun',
'from_name' => 'PaginiumCMS',
'enabled' => false
];

// ============================================================
# TESTOVACIA FUNKCIA (BEZ MAILER)
// ============================================================
function testSmtpConnection($config) {
    $result = [
        'success' => false,
        'message' => '',
        'details' => []
    ];

    // 1. Kontrola hosta
    if (empty($config['host'])) {
        $result['message'] = 'Chýba SMTP server (host)';
        return $result;
    }

    // 2. Kontrola portu
    $port = (int)$config['port'];
    if ($port < 1 || $port > 65535) {
        $result['message'] = 'Neplatný port';
        return $result;
    }

    // 3. Test pripojenia cez socket
    $timeout = 5;
    $connection = @fsockopen($config['host'], $port, $errno, $errstr, $timeout);

    if (!$connection) {
        $result['message'] = "Nepodarilo sa pripojiť k serveru: $errstr ($errno)";
        return $result;
    }

    fclose($connection);
    $result['details']['connection'] = "✅ Pripojenie k serveru {$config['host']}:{$port} úspešné";

    // 4. Simulácia odoslania emailu
    $result['details']['email_test'] = '📧 Testovací email bol simulovaný (SMTP vypnuté)';
    $result['success'] = true;
    $result['message'] = 'Pripojenie k serveru úspešné! (Email je simulovaný)';

    return $result;
}

// ============================================================
# SPRACOVANIE REQUESTU
// ============================================================
try {
    if ($_SERVER['REQUEST_METHOD'] === 'POST') {
        $action = $input['action'] ?? '';

        if ($action === 'test') {
            $result = testSmtpConnection($smtpConfig);

            echo json_encode([
                'success' => $result['success'],
                'message' => $result['message'],
                'details' => $result['details'] ?? []
            ]);
            exit();
        }

        if ($action === 'send-test') {
            $testEmail = $input['email'] ?? $smtpConfig['from_email'] ?? 'test@example.com';

            // Simulácia odoslania
            $logFile = __DIR__ . '/../../storage/mail_debug.log';
            $logDir = dirname($logFile);
            if (!is_dir($logDir)) {
                mkdir($logDir, 0755, true);
            }

            $log = date('c') . " | 📧 Testovací email na: $testEmail\n";
            $log .= "SMTP server: {$smtpConfig['host']}:{$smtpConfig['port']}\n";
            $log .= "---\n";
            file_put_contents($logFile, $log, FILE_APPEND);

            echo json_encode([
                'success' => true,
                'message' => "Testovací email bol simulovaný na $testEmail",
                'simulated' => true
            ]);
            exit();
        }

        http_response_code(400);
        echo json_encode(['success' => false, 'error' => 'Neznáma akcia']);
        exit();
    }

    http_response_code(405);
    echo json_encode(['success' => false, 'error' => 'Metóda nie je podporovaná']);

} catch (Exception $e) {
    http_response_code(500);
    echo json_encode([
        'success' => false,
        'error' => $e->getMessage()
    ]);
}
