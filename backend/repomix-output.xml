        file_put_contents($usersFile, json_encode([], JSON_PRETTY_PRINT));
        return [];
    }
    $content = file_get_contents($usersFile);
    $users = json_decode($content, true);
    return is_array($users) ? $users : [];
}

function saveUsers($users) {
    global $usersFile;
    file_put_contents($usersFile, json_encode($users, JSON_PRETTY_PRINT));
}

// ============================================================
# SPRACOVANIE REQUESTU
// ============================================================
try {
    switch ($method) {
        case 'GET':
            $users = getUsers();
            // Odstránime heslá z odpovede
            $safeUsers = array_map(function($user) {
                unset($user['password']);
                unset($user['verificationToken']);
                return $user;
            }, $users);

            echo json_encode([
                'success' => true,
                'data' => $safeUsers,
                'count' => count($safeUsers)
            ]);
            break;

        case 'POST':
            $newUser = [
                'id' => uniqid('user_'),
                'name' => $input['name'] ?? $input['displayName'] ?? '',
                'username' => $input['username'] ?? '',
                'email' => $input['email'] ?? '',
                'displayName' => $input['displayName'] ?? $input['name'] ?? '',
                'password' => password_hash($input['password'] ?? 'password', PASSWORD_BCRYPT),
                'role' => $input['role'] ?? 'user',
                'status' => 'active',
                'verified' => false,
                'createdAt' => date('c'),
                'updatedAt' => date('c')
            ];

            $users = getUsers();
            $users[] = $newUser;
            saveUsers($users);

            unset($newUser['password']);
            echo json_encode([
                'success' => true,
                'data' => $newUser,
                'message' => 'Používateľ vytvorený'
            ]);
            break;

        case 'PUT':
            $id = $input['id'] ?? $_GET['id'] ?? '';
            if (empty($id)) {
                http_response_code(400);
                echo json_encode(['success' => false, 'error' => 'Chýbajúce ID']);
                break;
            }

            $users = getUsers();
            $found = false;
            foreach ($users as &$user) {
                if ($user['id'] === $id) {
                    $user['name'] = $input['name'] ?? $user['name'] ?? '';
                    $user['username'] = $input['username'] ?? $user['username'] ?? '';
                    $user['email'] = $input['email'] ?? $user['email'] ?? '';
                    $user['displayName'] = $input['displayName'] ?? $user['displayName'] ?? $user['name'] ?? '';
                    $user['role'] = $input['role'] ?? $user['role'] ?? 'user';
                    $user['status'] = $input['status'] ?? $user['status'] ?? 'active';
                    $user['updatedAt'] = date('c');
                    $user['skipCommentApproval'] = $input['skipCommentApproval'] ?? $user['skipCommentApproval'] ?? false;
                    $user['avatar'] = $input['avatar'] ?? $user['avatar'] ?? '';
                    $user['status'] = $input['status'] ?? $user['status'] ?? 'active';
                    $found = true;
                    break;
                }
            }

            if (!$found) {
                http_response_code(404);
                echo json_encode(['success' => false, 'error' => 'Používateľ nenájdený']);
                break;
            }

            saveUsers($users);
            echo json_encode(['success' => true, 'message' => 'Používateľ aktualizovaný']);
            break;

        case 'DELETE':
            $id = $_GET['id'] ?? $input['id'] ?? '';
            if (empty($id)) {
                http_response_code(400);
                echo json_encode(['success' => false, 'error' => 'Chýbajúce ID']);
                break;
            }

            $users = getUsers();
            $filtered = array_filter($users, function($user) use ($id) {
                return $user['id'] !== $id;
            });

            if (count($filtered) === count($users)) {
                http_response_code(404);
                echo json_encode(['success' => false, 'error' => 'Používateľ nenájdený']);
                break;
            }

            saveUsers(array_values($filtered));
            echo json_encode([
                'success' => true,
                'message' => "Používateľ $id vymazaný"
            ]);
            break;

        default:
            http_response_code(405);
            echo json_encode([
                'success' => false,
                'error' => 'Metóda nie je podporovaná'
            ]);
    }
} catch (Exception $e) {
    http_response_code(500);
    echo json_encode([
        'success' => false,
        'error' => $e->getMessage()
    ]);
}
