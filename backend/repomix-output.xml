header('Access-Control-Allow-Methods: GET, POST, PUT, OPTIONS');
header('Access-Control-Allow-Headers: Content-Type, Authorization, X-CSRF-TOKEN');

if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(200);
    echo json_encode(['success' => true]);
    exit();
}

// ============================================================
# NAČÍTANIE DEBUG TRIEDY
// ============================================================
require_once __DIR__ . '/../../core/Debug.php';

// ============================================================
# JEDNODUCHÁ AUTENTIFIKÁCIA (namiesto Auth triedy)
// ============================================================
function isAdmin() {
    // Pre vývoj - povolíme všetkých
    // V produkcii treba overiť JWT token
    return true;
}

// Kontrola prístupu
if (!isAdmin()) {
    http_response_code(401);
    echo json_encode(['success' => false, 'error' => 'Neoprávnený prístup']);
    exit();
}

// ============================================================
# SPRACOVANIE REQUESTU
// ============================================================
$method = $_SERVER['REQUEST_METHOD'];
$input = json_decode(file_get_contents('php://input'), true) ?? [];

try {
    $debug = Debug::getInstance();

    switch ($method) {
        case 'GET':
            echo json_encode([
                'success' => true,
                'data' => $debug->getConfig(),
                             'enabled' => $debug->isEnabled()
            ]);
            break;

        case 'PUT':
            $enabled = $input['enabled'] ?? null;
            if ($enabled === null) {
                http_response_code(400);
                echo json_encode(['success' => false, 'error' => 'Chýba parameter "enabled"']);
                break;
            }

            $config = $debug->getConfig();
            $config['enabled'] = (bool)$enabled;

            if ($config['enabled']) {
                $config['display_errors'] = $input['display_errors'] ?? true;
                $config['log_errors'] = $input['log_errors'] ?? true;
                $config['show_sql_queries'] = $input['show_sql_queries'] ?? false;
                $config['show_execution_time'] = $input['show_execution_time'] ?? false;
                $config['show_toasts'] = $input['show_toasts'] ?? true;
            }

            $debug->saveConfig($config);

            echo json_encode([
                'success' => true,
                'message' => $config['enabled'] ? 'Debug bol zapnutý' : 'Debug bol vypnutý',
                'data' => $config
            ]);
            break;

        case 'POST':
            $action = $input['action'] ?? '';

            if ($action === 'logs') {
                $logFile = __DIR__ . '/../../storage/logs/debug.log';
                $logs = [];

                if (file_exists($logFile)) {
                    $lines = file($logFile);
                    $limit = $input['limit'] ?? 50;

                    foreach (array_reverse($lines) as $line) {
                        $log = json_decode($line, true);
                        if ($log) {
                            $logs[] = $log;
                        }
                        if (count($logs) >= $limit) break;
                    }
                }

                echo json_encode([
                    'success' => true,
                    'data' => $logs,
                    'count' => count($logs)
                ]);
                break;
            }

            if ($action === 'clear') {
                $logFile = __DIR__ . '/../../storage/logs/debug.log';
                if (file_exists($logFile)) {
                    file_put_contents($logFile, '');
                }
                echo json_encode([
                    'success' => true,
                    'message' => 'Debug logy boli vymazané'
                ]);
                break;
            }

            http_response_code(400);
            echo json_encode(['success' => false, 'error' => 'Neznáma akcia']);
            break;

        default:
            http_response_code(405);
            echo json_encode(['success' => false, 'error' => 'Metóda nie je podporovaná']);
    }

} catch (Exception $e) {
    http_response_code(500);
    echo json_encode([
        'success' => false,
        'error' => $e->getMessage()
    ]);
}
