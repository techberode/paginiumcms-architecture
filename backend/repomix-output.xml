<file path="v1/auth.php">
<?php
// ============================================================
// AUTH API - REGISTRÁCIA A PRIHLASOVANIE
// ============================================================

header('Content-Type: application/json');
header('Access-Control-Allow-Origin: http://localhost:3022');
header('Access-Control-Allow-Credentials: true');
header('Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS');
header('Access-Control-Allow-Headers: Content-Type, Authorization, X-CSRF-TOKEN');

if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(200);
    echo json_encode(['success' => true]);
    exit();
}

$method = $_SERVER['REQUEST_METHOD'];
$input = json_decode(file_get_contents('php://input'), true) ?? [];

// ============================================================
# KONFIGURÁCIA
// ============================================================
$usersFile = __DIR__ . '/../../storage/users.json';
$verificationDir = __DIR__ . '/../../storage/verification/';

if (!is_dir($verificationDir)) {
    mkdir($verificationDir, 0755, true);
}

// ============================================================
# POMOCNÉ FUNKCIE
// ============================================================

function getUsers() {
    global $usersFile;
    if (!file_exists($usersFile)) {
        return [];
    }
    $content = file_get_contents($usersFile);
    $users = json_decode($content, true);
    return is_array($users) ? $users : [];
}

function saveUsers($users) {
    global $usersFile;
    file_put_contents($usersFile, json_encode($users, JSON_PRETTY_PRINT));
}

// ============================================================
# SPRACOVANIE REQUESTU
// ============================================================
try {
    if ($method === 'POST') {
        $action = $input['action'] ?? '';

        // ============================================================
        # PRIHLASOVANIE
        // ============================================================
        if ($action === 'login') {
            $email = trim($input['email'] ?? '');
            $password = $input['password'] ?? '';

            if (empty($email) || empty($password)) {
                http_response_code(400);
                echo json_encode(['success' => false, 'error' => 'Chýbajúce prihlasovacie údaje']);
                exit();
            }

            $users = getUsers();
            $foundUser = null;

            foreach ($users as $user) {
                $userEmail = $user['email'] ?? '';
                $userUsername = $user['username'] ?? '';

                if ($userEmail === $email || $userUsername === $email) {
                    // DEBUG - zapíš do logu
                    error_log("🔍 Nájdený používateľ: " . $user['username']);
                    error_log("🔐 Overujem heslo: " . ($password === 'admin' ? 'admin (test)' : $password));

                    if (password_verify($password, $user['password'] ?? '')) {
                        $foundUser = $user;
                        error_log("✅ Heslo správne!");
                        break;
                    } else {
                        error_log("❌ Heslo nesprávne!");
                    }
                }
            }

            // 🔧 TOTO BOLO NA ZLOM MIESTE - presunuté sem
            if (!$foundUser) {
                http_response_code(401);
                echo json_encode(['success' => false, 'error' => 'Nesprávne prihlasovacie údaje']);
                exit();
            }

            // Odstránime citlivé údaje
            unset($foundUser['password']);
            unset($foundUser['verificationToken']);

            echo json_encode([
                'success' => true,
                'message' => 'Prihlásenie úspešné',
                'user' => [
                    'id' => $foundUser['id'],
                    'name' => $foundUser['name'] ?? $foundUser['username'],
                    'username' => $foundUser['username'],
                    'email' => $foundUser['email'],
                    'role' => $foundUser['role'] ?? 'user',
                    'verified' => $foundUser['verified'] ?? true,
                ]
            ]);
            exit();
        }

        // ============================================================
        # REGISTRÁCIA
        // ============================================================
        if ($action === 'register') {
            $name = trim($input['name'] ?? $input['displayName'] ?? '');
            $email = trim($input['email'] ?? '');
            $username = trim($input['username'] ?? '');
            $password = $input['password'] ?? '';
            $passwordConfirm = $input['passwordConfirm'] ?? $input['confirmPassword'] ?? '';

            // Validácia
            $errors = [];
            if (empty($name) || strlen($name) < 2) {
                $errors[] = 'Meno musí mať aspoň 2 znaky';
            }
            if (empty($email) || !filter_var($email, FILTER_VALIDATE_EMAIL)) {
                $errors[] = 'Zadajte platnú emailovú adresu';
            }
            if (empty($username) || strlen($username) < 2) {
                $errors[] = 'Používateľské meno musí mať aspoň 2 znaky';
            }
            if (empty($password) || strlen($password) < 8) {
                $errors[] = 'Heslo musí mať aspoň 8 znakov';
            }
            if ($password !== $passwordConfirm) {
                $errors[] = 'Heslá sa nezhodujú';
            }

            if (!empty($errors)) {
                http_response_code(400);
                echo json_encode(['success' => false, 'errors' => $errors]);
                exit();
            }

            // Kontrola existujúceho používateľa
            $users = getUsers();
            foreach ($users as $user) {
                if (($user['email'] ?? '') === $email) {
                    http_response_code(409);
                    echo json_encode(['success' => false, 'errors' => ['Používateľ s týmto emailom už existuje']]);
                    exit();
                }
                if (($user['username'] ?? '') === $username) {
                    http_response_code(409);
                    echo json_encode(['success' => false, 'errors' => ['Používateľské meno je už obsadené']]);
                    exit();
                }
            }

            // Vytvorenie používateľa
            $hashedPassword = password_hash($password, PASSWORD_BCRYPT);
            $token = bin2hex(random_bytes(32));

            $newUser = [
                'id' => uniqid('user_'),
                'name' => $name,
                'username' => $username,
                'email' => $email,
                'password' => $hashedPassword,
                'role' => 'user',
                'verified' => true,
                'verificationToken' => $token,
                'createdAt' => date('c'),
                'updatedAt' => date('c')
            ];

            $users[] = $newUser;
            saveUsers($users);

            // Odstránime citlivé údaje z odpovede
            unset($newUser['password']);
            unset($newUser['verificationToken']);

            echo json_encode([
                'success' => true,
                'message' => 'Registrácia úspešná! Môžete sa prihlásiť.',
                'user' => [
                    'id' => $newUser['id'],
                    'name' => $newUser['name'],
                    'username' => $newUser['username'],
                    'email' => $newUser['email'],
                    'role' => $newUser['role'],
                    'verified' => $newUser['verified'],
                ]
            ]);
            exit();
        }

        http_response_code(400);
        echo json_encode(['success' => false, 'error' => 'Neznáma akcia']);
        exit();
    }

    http_response_code(405);
    echo json_encode(['success' => false, 'error' => 'Metóda nie je podporovaná']);
    exit();

} catch (Exception $e) {
    http_response_code(500);
    echo json_encode([
        'success' => false,
        'error' => $e->getMessage()
    ]);
}
