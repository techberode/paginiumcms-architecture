    $subject = trim($input['subject'] ?? '');
    $message = trim($input['message'] ?? '');

    if (empty($name) || strlen($name) < 2) {
        throw new Exception('Meno je povinné (min. 2 znaky)');
    }
    if (empty($email) || !filter_var($email, FILTER_VALIDATE_EMAIL)) {
        throw new Exception('Zadajte platnú emailovú adresu');
    }
    if (empty($message) || strlen($message) < 10) {
        throw new Exception('Správa je povinná (min. 10 znakov)');
    }

    $dir = __DIR__ . '/../../storage/messages/';
    if (!is_dir($dir)) {
        mkdir($dir, 0755, true);
    }

    $filename = $dir . 'msg_' . date('Y-m-d_His') . '_' . uniqid() . '.json';
    file_put_contents($filename, json_encode([
        'name' => $name,
        'email' => $email,
        'subject' => $subject ?: 'Všeobecná otázka',
        'message' => $message,
        'createdAt' => date('c'),
