# ============================================
# PAGINIUMCMS - STORAGE OCHRANA
# ============================================
# POZNÁMKA: Docroot MUSÍ byť backend/public/. storage/ (vrátane data/ s
# používateľmi, settings.json, logs/, backups/) je mimo docrootu a NIKDY sa
# nemá servírovať web serverom priamo. Toto .htaccess je len defense-in-depth
# pre prípad chybnej konfigurácie Apache (docroot omylom nad public/).
# Nginx: deny script URLs under /storage/ + proxy to PHP. Apache: docs/deploy/apache-storage.htaccess

# Apache 2.4+ (mod_authz_core) – úplný zákaz.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (mod_access_compat) – spätná kompatibilita.
<IfModule mod_access_compat.c>
    Order Deny,Allow
    Deny from all
</IfModule>

# Blokovanie prístupu k .env a .git
<FilesMatch "^\.">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Blokovanie JSON súborov s dátami používateľov
<FilesMatch "\.(json|yml|yaml)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Povolenie ZIP súborov pre zálohy (iba ak sú v podadresári backups)
<LocationMatch "/backups/.*\.zip$">
    Order Deny,Allow
    Deny from all
</LocationMatch>
