#!/usr/bin/env php
<?php

declare(strict_types=1);

use Symfony\Component\Console\Application;
use PaginiumCMS\Modules\Audit\Commands\RunAuditCommand;
use PaginiumCMS\Core\Backup\Commands\RunBackupScheduleCommand;
use PaginiumCMS\Core\Monitoring\Commands\RunMonitoringScheduleCommand;
use PaginiumCMS\Core\Seo\Commands\RedirectValidateCommand;
use PaginiumCMS\Core\Scheduler\Commands\ProcessWorkerCommand;
use PaginiumCMS\Core\Scheduler\Commands\RunJobCommand;
use PaginiumCMS\Core\Scheduler\Commands\RunSchedulerCommand;
use PaginiumCMS\Core\Cache\Commands\PurgeContentCacheCommand;
use PaginiumCMS\Core\FlatFile\Commands\ContentDiagnoseCommand;
use PaginiumCMS\Core\FlatFile\Commands\ContentLocaleMigrateCommand;
use PaginiumCMS\Modules\Demo\Commands\RunDemoResetCommand;
use PaginiumCMS\Core\SystemUpdate\Commands\SystemDeployCommand;
use PaginiumCMS\Modules\Security\Commands\ClearLoginLockoutsCommand;

require_once __DIR__ . '/../../vendor/autoload.php';

$app = require_once __DIR__ . '/../bootstrap/app.php';
$container = $app->getContainer();

$application = new Application('PaginiumCMS', '2.0');
$application->addCommand($container->get(RunAuditCommand::class));
$application->addCommand($container->get(RunBackupScheduleCommand::class));
$application->addCommand($container->get(RunMonitoringScheduleCommand::class));
$application->addCommand($container->get(RunSchedulerCommand::class));
$application->addCommand($container->get(RunJobCommand::class));
$application->addCommand($container->get(ProcessWorkerCommand::class));
$application->addCommand($container->get(PurgeContentCacheCommand::class));
$application->addCommand($container->get(ContentDiagnoseCommand::class));
$application->addCommand($container->get(ContentLocaleMigrateCommand::class));
$application->addCommand($container->get(RunDemoResetCommand::class));
$application->addCommand($container->get(ClearLoginLockoutsCommand::class));
$application->addCommand($container->get(SystemDeployCommand::class));
$application->addCommand($container->get(RedirectValidateCommand::class));
$application->run();
