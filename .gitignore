###############################################################################
# PaginiumCMS
# Production-ready .gitignore
###############################################################################

###############################################################################
# Private local docs (NEVER commit) — personal ops / QA checklists only
###############################################################################
SECURITY_ISSUES.md
PRIVATE_OPS_CHECKLIST.md
PRIVATE_DOMAIN_DEPLOY.md
docs/FINAL_BETA1_ITERATION.md

# LAN / deploy — lokálne env (nikdy necommituj host/user/port)
scripts/deploy-frontend-lan.env
scripts/deploy-frontend-lan.env.local
scripts/deploy-*.env.local

###############################################################################
# Composer
###############################################################################

/vendor/
composer.phar

###############################################################################
# Node / React / Vite
###############################################################################

node_modules/
frontend/node_modules/

dist/
build/
frontend/dist/
frontend/build/

.vite/
frontend/.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

###############################################################################
# Environment
###############################################################################

.env
.env.*
!.env.example

###############################################################################
# Runtime
###############################################################################

/cache/
/tmp/
/temp/
/sessions/
/storage/cache/
/storage/tmp/
/storage/sessions/
/storage/translations/
backend/storage/dev/registered_tokens.json
backend/storage/logs/developer/
backend/storage/logs/debug/
/prototype/

###############################################################################
# Test & runtime artifacts (PHPUnit, Vitest, local dev)
###############################################################################

# Legacy user records at repo root (generated by tests)
/users/*.json

# Backend runtime storage
backend/storage/backups/
backend/storage/cache/
backend/storage/dev/
backend/storage/logs/
backend/storage/app/content/data/

# Flat-file runtime content (PHPUnit, local dev — not seed data)
backend/storage/app/content/pages/
backend/storage/app/content/blog/
backend/storage/app/content/media/
backend/storage/app/content/trash/

# Demo sandbox runtime (seeded on boot when DEMO_MODE=true)
backend/storage/app/demo/*
!backend/storage/app/demo/.gitkeep

# Misplaced runtime logs under app/ (should use backend/storage/logs/)
backend/app/storage/

# Runtime flat-file state (generated at runtime, not seed data)
backend/data/users/
backend/data/drafts/
backend/data/*.json
!backend/data/.gitkeep

# Screenshots from manual QA
/screenshots/

# Static analysis temporary output
phpstan-temp.json
phpstan-temp.pdf
phpstan-temp.table
phpstan-errors.json
phpstan-report.md
phpstan-report.table
project-tree*.txt
project-tree*.pdf
project-tree*.md
phpstan-temp*.json
phpstan-temp*.table
phpstan-temp*.pdf

# Repomix code dumps (AI export, not source)
repomix-output*.xml
repomix-output*.pdf
**/repomix-output*.xml
**/repomix-output*.pdf

###############################################################################
# Logs
###############################################################################

/logs/
*.log

###############################################################################
# PHPUnit
###############################################################################

.phpunit.cache/
coverage/
coverage.xml
junit.xml
clover.xml

###############################################################################
