# Copy next to docker-compose.libretranslate.yml or export before `docker compose up`.
# Pin the image after first successful deploy (avoid `:latest` on production).

LIBRETRANSLATE_IMAGE=libretranslate/libretranslate:v1.6.4
LIBRETRANSLATE_PORT=5000
LIBRETRANSLATE_MEM_LIMIT=6g
LIBRETRANSLATE_CPUS=2

# Languages to load (LibreTranslate codes). Match CMS locales you translate between.
LT_LOAD_ONLY=sk,en,cs

LT_UPDATE_MODELS=true
LT_API_KEYS=true
LT_REQ_LIMIT=120
LT_CHAR_LIMIT=5000

# Set true if you only use CMS + nginx (no manual browser UI on :5000)
LT_DISABLE_WEB_UI=false
