{
  "info": {
    "name": "PaginiumCMS Smoke",
    "description": "Smoke collection for PaginiumCMS API (Iteration 21). Run with Newman after PHPUnit.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.9"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": "StrongP@ssw0rd123!"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('has success', () => pm.expect(j).to.have.property('success'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Content",
      "item": [
        {
          "name": "GET /api/pages (paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pages?page=1&per_page=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pages"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('paginated envelope', () => {",
                  "  pm.expect(j.success).to.eql(true);",
                  "  pm.expect(j).to.have.property('data');",
                  "  pm.expect(j).to.have.property('meta');",
                  "  pm.expect(j.meta).to.have.property('total_pages');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /api/search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/search?q=home",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search"],
              "query": [{ "key": "q", "value": "home" }]
            }
          }
        }
      ]
    },
    {
      "name": "Settings",
      "item": [
        {
          "name": "GET /api/settings/public",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/settings/public"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('settings envelope', () => {",
                  "  pm.expect(j.success).to.eql(true);",
                  "  pm.expect(j).to.have.property('data');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Validation",
      "item": [
        {
          "name": "GET /api/validation/rules",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/validation/rules"
          }
        }
      ]
    },
    {
      "name": "Public Feeds",
      "item": [
        {
          "name": "GET /feed.xml",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/feed.xml"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('rss xml', () => pm.expect(pm.response.text()).to.include('<rss'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /sitemap.xml",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/sitemap.xml"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('sitemap xml', () => pm.expect(pm.response.text()).to.include('<urlset'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /robots.txt",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/robots.txt"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('robots body', () => pm.expect(pm.response.text()).to.include('User-agent:'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
